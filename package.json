{
  "name": "qiy",
  "type": "module",
  "version": "0.7.0",
  "description": "Model-driven full-stack application generator: one Qiy model generates a Refine admin, Bun + Elysia API, Drizzle schema and deployment config.",
  "license": "MIT",
  "private": false,
  "bin": {
    "qiy": "tools/cli.ts"
  },
  "files": [
    "tools",
    "languages",
    "templates",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "qiy": "bun run tools/cli.ts",
    "deploy": "bun run deploy/index.ts",
    "template:build": "bun run tools/build-template.ts",
    "skill:build": "bun run tools/build-skill.ts",
    "build:exe": "bun run tools/build-exe.ts",
    "docs:assets": "bun run tools/build-docs-assets.ts",
    "docs:dev": "bun run docs:assets && vitepress dev docs",
    "docs:build": "bun run docs:assets && vitepress build docs && bun run tools/build-docs-version.ts",
    "docs:version": "bun run tools/build-docs-version.ts",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.42"
  },
  "resolutions": {
    "vue": "^3.5.42",
    "@vue/server-renderer": "^3.5.42"
  },
  "overrides": {
    "vue": "^3.5.42",
    "@vue/server-renderer": "^3.5.42"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
