entity movements @label("Stock movements") @icon(SwapOutlined) {
  field id UUID @id;
  field warehouseId UUID;
  field productId UUID;
  field type movementType;
  field quantity Integer;
  field occurredAt DateTime;
}

relation movementWarehouse movements warehouseId warehouses id one @onDelete(restrict);
relation movementProduct movements productId products id one @onDelete(restrict);
