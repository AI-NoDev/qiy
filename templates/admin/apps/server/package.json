{
  "name": "qiy-generated-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env.development --watch src/server.ts",
    "start": "bun --env-file=.env.production src/server.ts",
    "preview": "bun --env-file=.env.development src/preview.ts",
    "test": "bun test --preload ./tests/setup.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --env-file=.env.development run drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development run drizzle-kit migrate",
    "db:migrate:production": "bun --env-file=.env.production run drizzle-kit migrate",
    "attachments:cleanup": "bun src/storage/cleanup.ts",
    "attachments:orphans": "bun src/storage/orphans.ts"
  },
  "dependencies": {
    "@elysia/cors": "1.4.2",
    "@elysia/openapi": "1.4.16",
    "elysia": "1.4.30",
    "drizzle-orm": "0.45.3",
    "graphql": "17.0.2",
    "jose": "^6.1.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
