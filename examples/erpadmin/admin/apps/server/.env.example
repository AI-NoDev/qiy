# Qiy example environment for the generated admin server.
# This file is generated from the application's .qiy model.
DATABASE_URL=postgres://USER:PASSWORD@db.example.com:5432/qiy
HOST=0.0.0.0
PORT=3000
QIY_DEV_MODE=0
QIY_STORAGE_METADATA=database
QIY_STORAGE_PROVIDER=local
QIY_STORAGE_ROOT=./storage
QIY_AUTH_SECRET=

# QIY_AUTH_SECRET is generated for development. Set a unique 32-byte value in production; it signs password sessions and OAuth onboarding tokens.
