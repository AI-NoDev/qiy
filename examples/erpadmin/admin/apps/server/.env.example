DATABASE_URL=postgres://qiy:qiy@localhost:5432/qiy
QIY_DEV_MODE=1
# Local username/password login: required when .qiy uses `provider local`.
# Generate with: bun -e 'console.log(crypto.getRandomValues(new Uint8Array(32)).reduce((value, byte) => value + byte.toString(16).padStart(2, "0"), ""))'
# QIY_AUTH_SECRET=
# OIDC access-token verification: required when .qiy uses `provider oidc`, `oauth2`, or `sso`.
# QIY_OIDC_ISSUER=https://identity.example.com/
# QIY_OIDC_AUDIENCE=qiy-api
# QIY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# HOST=127.0.0.1
PORT=3000
QIY_STORAGE_PROVIDER=local
QIY_STORAGE_ROOT=./storage
# For S3-compatible storage, set QIY_STORAGE_PROVIDER=s3 and provide:
# QIY_S3_BUCKET=
# QIY_S3_REGION=
# QIY_S3_ENDPOINT=
# QIY_S3_ACCESS_KEY_ID=
# QIY_S3_SECRET_ACCESS_KEY=
# QIY_S3_SESSION_TOKEN=
