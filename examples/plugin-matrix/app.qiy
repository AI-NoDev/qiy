qiy v0;

application qiy-plugin-matrix {
  database sqlite {}
  api { client graphql; }
  elysia {
    bearer;
    serverTiming;
    html;
    drizzle;
    jwt { name accessToken; secretEnv QIY_ACCESS_SECRET; }
    static { assets "public"; prefix "/public-assets"; }
    graphqlAdapter adapter yoga;
    cron { job attachmentCleanup pattern "0 0 * * *" task cleanupMissingAttachments; }
  }
  storage { provider local; }
  auth { provider oidc; user users; subjectField subject; roleField role; }

  enum userRole {
    value admin;
    value operator;
    value viewer;
  }

  entity users {
    field id UUID @id;
    field subject Text @unique;
    field role userRole;
  }

  entity documents {
    field id UUID @id;
    field name Text;
    field attachment File @nullable;
  }
}
