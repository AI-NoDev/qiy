# Qiy production frontend environment.
# Configure a public SPA client with Authorization Code + PKCE. Never put a client secret in VITE_* variables.
VITE_QIY_API_TRANSPORT=rest
VITE_QIY_AUTHORIZATION_URL=
VITE_QIY_TOKEN_URL=
VITE_QIY_CLIENT_ID=
VITE_QIY_AUTH_SCOPE=openid profile email
VITE_QIY_REDIRECT_URI=
VITE_QIY_LOGOUT_URL=
