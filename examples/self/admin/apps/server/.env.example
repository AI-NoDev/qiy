# Qiy example environment for the generated admin server.
# This file is generated from the application's .qiy model.
DATABASE_URL=./qiy.sqlite
HOST=0.0.0.0
PORT=3000
QIY_DEV_MODE=0
QIY_STORAGE_METADATA=database
QIY_STORAGE_PROVIDER=local
QIY_STORAGE_ROOT=./storage
QIY_OIDC_ISSUER=https://identity.example.com/
QIY_OIDC_AUDIENCE=qiy-admin
QIY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
QIY_OIDC_JWKS_TIMEOUT_MS=5000
QIY_OIDC_JWKS_COOLDOWN_MS=30000
QIY_OIDC_JWKS_CACHE_MAX_AGE_MS=600000
QIY_ABLY_API_KEY=
QIY_REALTIME_DISABLED=0
QIY_REALTIME_POLL_MS=5000
QIY_REALTIME_LEASE_MS=30000
QIY_REALTIME_MAX_ATTEMPTS=10
QIY_REALTIME_RETENTION_DAYS=7
QIY_REALTIME_CLEANUP_MS=86400000
QIY_REALTIME_ADMIN_URL=https://admin.example.com/api/v1/realtime/outbox
QIY_REALTIME_ADMIN_TOKEN=
QIY_REALTIME_METRICS_TOKEN=
QIY_REALTIME_ALERT_MAX_PENDING=1000
QIY_REALTIME_ALERT_MAX_DEAD_LETTERED=0
QIY_REALTIME_ALERT_MAX_OLDEST_PENDING_MS=300000

# Configure the issuer, audience and JWKS URL for the selected OIDC/OAuth2/SSO provider.
# These settings validate access tokens; they are not OAuth client credentials.

# QIY_ABLY_API_KEY remains server-only. The browser obtains a role-scoped, subscribe-only token request from /api/v1/realtime/token.
# QIY_REALTIME_ADMIN_TOKEN is an administrator access token used only by the realtime:admin HTTP client; never commit it.
# QIY_REALTIME_METRICS_TOKEN is a separate read-only bearer token for Prometheus scraping; rotate it through the deployment secret.
