# Qiy example environment for the generated admin server.
# This file is generated from the application's .qiy model.
DATABASE_URL=./qiy.sqlite
HOST=0.0.0.0
PORT=3000
QIY_DEV_MODE=0
QIY_STORAGE_METADATA=database
QIY_STORAGE_PROVIDER=local
QIY_STORAGE_ROOT=./storage
QIY_AUTH_SECRET=
QIY_OIDC_JWKS_TIMEOUT_MS=5000
QIY_OIDC_JWKS_COOLDOWN_MS=30000
QIY_OIDC_JWKS_CACHE_MAX_AGE_MS=600000
QIY_OIDC_OKTA_ISSUER=https://okta.example.com/
QIY_OIDC_OKTA_AUDIENCE=qiy-admin
QIY_OIDC_OKTA_JWKS_URL=https://okta.example.com/.well-known/jwks.json
QIY_OIDC_OKTA_AUTHORIZATION_URL=https://YOUR_OKTA_DOMAIN/oauth2/default/v1/authorize
QIY_OIDC_OKTA_TOKEN_URL=https://YOUR_OKTA_DOMAIN/oauth2/default/v1/token
QIY_OIDC_OKTA_CLIENT_ID=qiy-admin-spa
QIY_OIDC_OKTA_SCOPE=openid profile email
QIY_OIDC_OKTA_REDIRECT_URI=https://admin.example.com/auth/callback
QIY_OIDC_KEYCLOAK_ISSUER=https://keycloak.example.com/
QIY_OIDC_KEYCLOAK_AUDIENCE=qiy-admin
QIY_OIDC_KEYCLOAK_JWKS_URL=https://keycloak.example.com/.well-known/jwks.json
QIY_OIDC_KEYCLOAK_AUTHORIZATION_URL=https://identity.example.com/realms/YOUR_REALM/protocol/openid-connect/auth
QIY_OIDC_KEYCLOAK_TOKEN_URL=https://identity.example.com/realms/YOUR_REALM/protocol/openid-connect/token
QIY_OIDC_KEYCLOAK_CLIENT_ID=qiy-admin-spa
QIY_OIDC_KEYCLOAK_SCOPE=openid profile email
QIY_OIDC_KEYCLOAK_REDIRECT_URI=https://admin.example.com/auth/callback
QIY_OIDC_GOOGLE_ISSUER=https://google.example.com/
QIY_OIDC_GOOGLE_AUDIENCE=qiy-admin
QIY_OIDC_GOOGLE_JWKS_URL=https://google.example.com/.well-known/jwks.json
QIY_OIDC_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
QIY_OIDC_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
QIY_OIDC_GOOGLE_CLIENT_ID=qiy-admin-spa
QIY_OIDC_GOOGLE_SCOPE=openid profile email
QIY_OIDC_GOOGLE_REDIRECT_URI=https://admin.example.com/auth/callback
QIY_OIDC_KINDE_ISSUER=https://kinde.example.com/
QIY_OIDC_KINDE_AUDIENCE=qiy-admin
QIY_OIDC_KINDE_JWKS_URL=https://kinde.example.com/.well-known/jwks.json
QIY_OIDC_KINDE_AUTHORIZATION_URL=https://YOUR_SUBDOMAIN.kinde.com/oauth2/auth
QIY_OIDC_KINDE_TOKEN_URL=https://YOUR_SUBDOMAIN.kinde.com/oauth2/token
QIY_OIDC_KINDE_CLIENT_ID=qiy-admin-spa
QIY_OIDC_KINDE_SCOPE=openid profile email
QIY_OIDC_KINDE_REDIRECT_URI=https://admin.example.com/auth/callback
QIY_OIDC_AZURE_AD_B2C_ISSUER=https://azure-ad-b2c.example.com/
QIY_OIDC_AZURE_AD_B2C_AUDIENCE=qiy-admin
QIY_OIDC_AZURE_AD_B2C_JWKS_URL=https://azure-ad-b2c.example.com/.well-known/jwks.json
QIY_OIDC_AZURE_AD_B2C_AUTHORIZATION_URL=https://YOUR_TENANT.b2clogin.com/YOUR_TENANT.onmicrosoft.com/YOUR_POLICY/oauth2/v2.0/authorize
QIY_OIDC_AZURE_AD_B2C_TOKEN_URL=https://YOUR_TENANT.b2clogin.com/YOUR_TENANT.onmicrosoft.com/YOUR_POLICY/oauth2/v2.0/token
QIY_OIDC_AZURE_AD_B2C_CLIENT_ID=qiy-admin-spa
QIY_OIDC_AZURE_AD_B2C_SCOPE=openid profile email
QIY_OIDC_AZURE_AD_B2C_REDIRECT_URI=https://admin.example.com/auth/callback
QIY_OIDC_DEFAULT_ROLE=viewer
QIY_ABLY_API_KEY=
QIY_REALTIME_DISABLED=0
QIY_REALTIME_POLL_MS=5000
QIY_REALTIME_LEASE_MS=30000
QIY_REALTIME_MAX_ATTEMPTS=10
QIY_REALTIME_RETENTION_DAYS=7
QIY_REALTIME_CLEANUP_MS=86400000
QIY_REALTIME_ADMIN_URL=https://admin.example.com/api/v1/realtime/outbox
QIY_REALTIME_ADMIN_TOKEN=
QIY_REALTIME_METRICS_TOKEN=
QIY_REALTIME_ALERT_MAX_PENDING=1000
QIY_REALTIME_ALERT_MAX_DEAD_LETTERED=0
QIY_REALTIME_ALERT_MAX_OLDEST_PENDING_MS=300000

# One QIY_OIDC_<PROVIDER>_* block per configured provider; only complete blocks appear on the public login page.
# These settings validate provider tokens; they are not OAuth client credentials.
# Set QIY_OIDC_<PROVIDER>_CLIENT_SECRET server-side only for confidential clients; never expose it in VITE_* variables.
# QIY_OIDC_DEFAULT_ROLE is the role for accounts created by first-time OAuth onboarding (default viewer).

# QIY_AUTH_SECRET is generated for development. Set a unique 32-byte value in production; it signs password sessions and OAuth onboarding tokens.

# QIY_ABLY_API_KEY remains server-only. The browser obtains a role-scoped, subscribe-only token request from /api/v1/realtime/token.
# QIY_REALTIME_ADMIN_TOKEN is an administrator access token used only by the realtime:admin HTTP client; never commit it.
# QIY_REALTIME_METRICS_TOKEN is a separate read-only bearer token for Prometheus scraping; rotate it through the deployment secret.
