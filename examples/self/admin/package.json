{
  "name": "qiy-supply-chain-erp-wms",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web --bun dev",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/server preview",
    "db:generate": "bun run --cwd apps/server --bun db:generate",
    "db:migrate": "bun run --cwd apps/server --bun db:migrate",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  },
  "description": "供应链 + ERP + WMS 演示应用：17 个实体、事务型业务命令与系统管理功能"
}
