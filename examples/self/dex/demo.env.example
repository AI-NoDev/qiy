# Demo environment for examples/self/admin/apps/server/.env.development
# Copy this file and fill the operator-specific secrets (Ably key, provider secrets).
PORT=8001
DATABASE_URL=./qiy.sqlite
HOST=0.0.0.0
QIY_STORAGE_METADATA=database
QIY_STORAGE_PROVIDER=local
QIY_STORAGE_ROOT=./storage
QIY_REALTIME_DISABLED=0

# Signs password session tokens and short-lived OAuth onboarding tokens.
# Must be at least 32 characters; generate one with: openssl rand -hex 32
QIY_AUTH_SECRET=

# Role assigned to accounts created by first-time OAuth onboarding (admin, operator or viewer).
QIY_OIDC_DEFAULT_ROLE=viewer

# OIDC providers (each <ID> becomes QIY_OIDC_<ID>_*)
# Dex instance A
QIY_OIDC_OKTA_ISSUER=http://localhost:5556/dex
QIY_OIDC_OKTA_AUDIENCE=qiy-admin
QIY_OIDC_OKTA_JWKS_URL=http://localhost:5556/dex/keys
QIY_OIDC_OKTA_AUTHORIZATION_URL=http://localhost:5556/dex/auth
QIY_OIDC_OKTA_TOKEN_URL=http://localhost:5556/dex/token
QIY_OIDC_OKTA_CLIENT_ID=qiy-admin
QIY_OIDC_OKTA_SCOPE=openid profile email offline_access
QIY_OIDC_OKTA_REDIRECT_URI=http://localhost:8000/auth/callback

# Dex instance B (different issuer, maps sub into keycloakSubject)
QIY_OIDC_KEYCLOAK_ISSUER=http://localhost:5557/dex
QIY_OIDC_KEYCLOAK_AUDIENCE=qiy-keycloak
QIY_OIDC_KEYCLOAK_JWKS_URL=http://localhost:5557/dex/keys
QIY_OIDC_KEYCLOAK_AUTHORIZATION_URL=http://localhost:5557/dex/auth
QIY_OIDC_KEYCLOAK_TOKEN_URL=http://localhost:5557/dex/token
QIY_OIDC_KEYCLOAK_CLIENT_ID=qiy-keycloak
QIY_OIDC_KEYCLOAK_SCOPE=openid profile email offline_access
QIY_OIDC_KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Real Google tenant (PKCE public client; the callback must be registered there)
QIY_OIDC_GOOGLE_ISSUER=https://accounts.google.com
QIY_OIDC_GOOGLE_AUDIENCE=<google client id>
QIY_OIDC_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
QIY_OIDC_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
QIY_OIDC_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
QIY_OIDC_GOOGLE_CLIENT_ID=<google client id>
# Google Web clients need the secret for the token exchange (kept server-side only).
QIY_OIDC_GOOGLE_CLIENT_SECRET=<google client secret>
QIY_OIDC_GOOGLE_SCOPE=openid profile email
QIY_OIDC_GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google

# Real Kinde tenant
QIY_OIDC_KINDE_ISSUER=https://windshage.kinde.com
QIY_OIDC_KINDE_AUDIENCE=<kinde client id>
QIY_OIDC_KINDE_JWKS_URL=https://windshage.kinde.com/.well-known/jwks
QIY_OIDC_KINDE_AUTHORIZATION_URL=https://windshage.kinde.com/oauth2/auth
QIY_OIDC_KINDE_TOKEN_URL=https://windshage.kinde.com/oauth2/token
QIY_OIDC_KINDE_CLIENT_ID=<kinde client id>
QIY_OIDC_KINDE_SCOPE=openid profile email
QIY_OIDC_KINDE_REDIRECT_URI=http://localhost:8000/oauth/kinde

# Microsoft Entra External ID tenant
QIY_OIDC_AZURE_AD_B2C_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
QIY_OIDC_AZURE_AD_B2C_AUDIENCE=<application client id>
QIY_OIDC_AZURE_AD_B2C_JWKS_URL=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
QIY_OIDC_AZURE_AD_B2C_AUTHORIZATION_URL=https://<tenant>.ciamlogin.com/<tenant-id>/oauth2/v2.0/authorize
QIY_OIDC_AZURE_AD_B2C_TOKEN_URL=https://<tenant>.ciamlogin.com/<tenant-id>/oauth2/v2.0/token
QIY_OIDC_AZURE_AD_B2C_CLIENT_ID=<application client id>
QIY_OIDC_AZURE_AD_B2C_SCOPE=openid profile email
QIY_OIDC_AZURE_AD_B2C_REDIRECT_URI=http://localhost:8000/oauth/azure

# Real Ably app for realtime (keep out of version control)
QIY_ABLY_API_KEY=<ably api key>
