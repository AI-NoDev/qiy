qiy v0;

# Supply chain + ERP + WMS in one generated Qiy application.
#
# The model lives in domain modules under modules/ instead of one monolith:
#   modules/platform.qiy          shared enums + the auth users entity
#   modules/scm/entities.qiy      organizations, suppliers, customers, products, BOM
#   modules/erp/entities.qiy      purchase/sales orders, lines, receipts, shipments
#   modules/wms/entities.qiy      warehouses, bins, inventory, movements, work orders
#   modules/relations.qiy         every relation (parser order: after all entities)
#   modules/messages.qiy          complete zh-CN / en-US dictionary for model labels
#   modules/permissions.qiy       permission fields, groups, provider sources and verifications
#   modules/pages.qiy             page-level role rules (after scope/restrict)
#   modules/menu.qiy              sidebar groups (after pages, before charts)
#   modules/charts.qiy            multi-view chart dashboard (dashboard position)
#   modules/dataflows.qiy         transactional business commands
#   modules/actions.qiy           list/show action buttons bound to those dataflows
#
# `include` only inserts application fragments: included files have no `qiy v0;`
# or `application {}` header, and the expanded model must keep the V0 section
# order (database -> config -> messages -> enums -> entities -> relations ->
# scope/restrict -> pages -> menu -> dashboard -> dataflows -> actions).
#
# One login page offers password login plus every configured OIDC provider. The
# first OAuth sign-in of an unknown identity lands on an onboarding form that
# creates the users row (and a password); existing accounts can bind or unbind
# additional providers from the personal center at /profile.
application qiy-supply-chain-erp-wms {
  database sqlite {}
  api { client rest; }

  realtime {
    mode auto;
    resource inventory {
      events created, updated, deleted;
      roles admin, operator;
    }
    resource stock_movements {
      events created;
      roles admin, operator;
    }
    resource shipments {
      events created, updated;
      roles admin, operator;
    }
  }

  auth {
    providers local, okta, keycloak, google, kinde, azure-ad-b2c;
    user users;
    subjectField subject;
    roleField role;
    usernameField email;
    passwordField passwordHash;
    profileField oauthProfiles;
    provider okta { subjectField oktaSubject; }
    provider keycloak { subjectField keycloakSubject; }
    provider google { subjectField googleSubject; }
    provider kinde { subjectField kindeSubject; }
    provider azure-ad-b2c { subjectField azureSubject; }
  }

  # Messages must follow the configuration blocks and stay before enums/entities.
  include "modules/messages.qiy";

  # Permission declarations follow messages (they can use @label messages) and
  # precede enums/entities (they are validated against the declared users table).
  include "modules/permissions.qiy";

  # Shared enums come first, then one entity module per domain.
  include "modules/platform.qiy";
  include "modules/scm/entities.qiy";
  include "modules/erp/entities.qiy";
  include "modules/wms/entities.qiy";

  # Relations must follow every entity module.
  include "modules/relations.qiy";

  # Warehouses are visible to the organization subtree carried by the token claim.
  scope warehouses orgId claim org.id;

  restrict products {
    allow roles admin, operator;
    mask unitCost roles operator, viewer mode redact replacement "***";
  }

  # UI configuration comes after scope/restrict. `menu` precedes charts/dashboard.
  include "modules/pages.qiy";
  include "modules/menu.qiy";
  include "modules/charts.qiy";
  include "modules/dataflows.qiy";
  include "modules/actions.qiy";
}
