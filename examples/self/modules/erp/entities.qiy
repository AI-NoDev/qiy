# ERP domain: purchasing and sales documents. Entities only; purchase/sales
# header-line relations and warehouse relations are declared in relations.qiy.

entity purchase_orders @label("Purchase orders") @icon(FileTextOutlined) @singular("Purchase order") @plural("Purchase orders") @display("{$.number}") @tableDisplay("{$.number}") @relationDetail("<b>{$.number}</b></br>{$.status} · {$.total}") {
  field id UUID @id;
  field number Text @unique;
  field supplierId UUID;
  field status purchaseStatus;
  field orderedAt DateTime;
  field expectedDate Date;
  field total Decimal(12,2);
}

entity purchase_order_lines @label("Purchase order lines") @icon(UnorderedListOutlined) @singular("Purchase order line") @plural("Purchase order lines") @display("{$.quantity}") @tableDisplay("{$.quantity}") @relationDetail("{$.quantity} · {$.unitCost}") {
  field id UUID @id;
  field purchaseOrderId UUID;
  field productId UUID;
  field quantity Integer;
  field unitCost Decimal(12,2);
}

entity receipts @label("Goods receipts") @icon(InboxOutlined) @singular("Goods receipt") @plural("Goods receipts") @display("{$.status}") @tableDisplay("{$.status}") @relationDetail("<b>{$.status}</b></br>{$.receivedAt}") {
  field id UUID @id;
  field purchaseOrderId UUID;
  field warehouseId UUID;
  field status Text;
  field receivedAt DateTime @nullable;
}

entity sales_orders @label("Sales orders") @icon(ShoppingCartOutlined) @singular("Sales order") @plural("Sales orders") @display("{$.number}") @tableDisplay("{$.number}") @relationDetail("<b>{$.number}</b></br>{$.status} · {$.total}") {
  field id UUID @id;
  field number Text @unique;
  field customerId UUID;
  field status salesStatus;
  field orderedAt DateTime;
  field total Decimal(12,2);
}

entity sales_order_lines @label("Sales order lines") @icon(OrderedListOutlined) @singular("Sales order line") @plural("Sales order lines") @display("{$.quantity}") @tableDisplay("{$.quantity}") @relationDetail("{$.quantity} · {$.unitPrice}") {
  field id UUID @id;
  field salesOrderId UUID;
  field productId UUID;
  field quantity Integer;
  field unitPrice Decimal(12,2);
  field allocated Integer;
}

entity shipments @label("Shipments") @icon(CarOutlined) @singular("Shipment") @plural("Shipments") @display("{$.status}") @tableDisplay("{$.status}") @relationDetail("<b>{$.status}</b></br>{$.shippedAt}") {
  field id UUID @id;
  field salesOrderId UUID;
  field warehouseId UUID;
  field status Text;
  field shippedAt DateTime @nullable;
  field departureTime Time @nullable;
}
