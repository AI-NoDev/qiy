# SCM domain: supply-chain master data (organizations, suppliers, customers,
# products, bills of materials). Entities only; relations live in relations.qiy
# because the parser requires every relation after every entity.

entity orgs @label("Organizations") @icon(ClusterOutlined) @singular("Organization") @plural("Organizations") @display("{$.code} · {$.name}") @tableDisplay("{$.code} · {$.name}") @relationDetail("<b>{$.name}</b></br>{$.code}") {
  field id UUID @id;
  field code Text @unique;
  field name Text;
  field parentId UUID @nullable;
}

entity suppliers @label("Suppliers") @icon(ShopOutlined) @singular("Supplier") @plural("Suppliers") @display("{$.code} · {$.name}") @tableDisplay("{$.code} · {$.name}") @relationDetail("<b>{$.name}</b></br>{$.code} · {$.leadTimeDays}") {
  field id UUID @id;
  field code Text @unique;
  field name Text;
  field email Text @nullable;
  field leadTimeDays Integer;
}

entity customers @label("Customers") @icon(TeamOutlined) @singular("Customer") @plural("Customers") @display("{$.code} · {$.name}") @tableDisplay("{$.code} · {$.name}") @relationDetail("<b>{$.name}</b></br>{$.code} · {$.creditLimit}") {
  field id UUID @id;
  field code Text @unique;
  field name Text;
  field email Text @nullable;
  field creditLimit Decimal(12,2);
}

entity products @label("Products") @icon(ShoppingOutlined) @singular("Product") @plural("Products") @display("{$.sku} · {$.name}") @tableDisplay("{$.sku} · {$.name}") @relationDetail("<b>{$.name}</b></br>{$.sku} · {$.price} · {$.active}") {
  field id UUID @id;
  field sku Text @unique;
  field name Text;
  field uom Text;
  field unitCost Decimal(12,2);
  field price Decimal(12,2);
  field reorderPoint Integer;
  field active activeState;
}

entity boms @label("Bill of materials") @icon(ApartmentOutlined) @singular("BOM line") @plural("Bill of materials") @display("{$.quantity}") @tableDisplay("{$.quantity}") @relationDetail("{$.quantity}") {
  field id UUID @id;
  field productId UUID;
  field componentId UUID;
  field quantity Integer;
}
