# Complete zh-CN / en-US dictionaries for every model-derived label this demo renders.
#
# Keys are stable and derived from declared identifiers, so renaming a label does not
# break a translation:
#   qiy.resources.<resource>.label                  resource and menu entry names
#   qiy.resources.<resource>.fields.<field>.label   list columns, detail labels and form labels
#   qiy.enums.<enum>.label / .values.<value>        enum value tags and select options
#   qiy.menu.<group>.label                          menu groups
#   qiy.dashboard.<metric>.label                    dashboard cards
#   qiy.actions.<action>.label / .confirm / .inputs.<input>.label   business commands
#
# The file is included right after the auth block; the parser requires `messages`
# to appear after env and before workflow/enum/entity declarations.
messages {
  default "zh-CN";
  locale "zh-CN" {
    # resources
    "qiy.resources.users.label" "用户";
