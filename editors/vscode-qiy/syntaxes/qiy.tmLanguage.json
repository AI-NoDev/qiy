{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qiy",
  "displayName": "Qiy",
  "scopeName": "source.qiy",
  "fileTypes": ["qiy"],
  "patterns": [
    { "include": "#testKeywords" },
    { "include": "#comments" }, { "include": "#strings" }, { "include": "#annotations" }, { "include": "#keywords" }, { "include": "#types" }, { "include": "#constants" }, { "include": "#numbers" }, { "include": "#operators" }
  ],
  "repository": {
    "testKeywords": { "patterns": [{ "name": "keyword.control.qiy", "match": "\\b(?:test|scenario|given|when|expect|identity|anonymous|claims|role|errorKey|exists|outbox|count)\\b" }] },
    "comments": { "patterns": [{ "name": "comment.line.double-slash.qiy", "match": "//.*$" }, { "name": "comment.line.number-sign.qiy", "match": "#.*$" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.qiy", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.qiy", "match": "\\\\." }] }, { "name": "string.quoted.single.qiy", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.qiy", "match": "\\\\." }] }] },
    "annotations": { "patterns": [{ "name": "storage.modifier.annotation.qiy", "match": "@[A-Za-z_][A-Za-z0-9_-]*" }] },
      "keywords": { "patterns": [{ "name": "keyword.control.qiy", "match": "\\b(?:qiy|v0|application|include|database|extension|workspace|name|aliases|packages|ui|library|theme|themes|colorMode|allowThemeSwitch|allowColorModeSwitch|light|dark|system|api|client|cors|origin|realtime|events|elysia|bearer|serverTiming|graphqlAdapter|adapter|cron|job|pattern|task|jwt|secretEnv|static|assets|prefix|html|drizzle|storage|provider|auth|user|subjectField|roleField|usernameField|passwordField|workflow|enum|value|label|color|icon|entity|table|field|index|relation|scope|claim|menu|group|resource|dashboard|metric|mode|integration|apiBase|csrfCookie|csrfHeader|env|variable|secret|development|production|example|generate|messages|default|locale|t|dataflow|idempotency|required|audit|allow|roles|input|context|by|step|require|update|result|return|action|navigate|placement|page)\\b" }] },
    "types": { "patterns": [{ "name": "support.type.qiy", "match": "\\b(?:UUID|Text|Integer|Decimal|Money|DateTime|File|Vector)\\b" }, { "name": "support.constant.database.qiy", "match": "\\b(?:postgresql|mysql|sqlite|pgvector|postgis|btree|hnsw|ivfflat)\\b" }] },
    "constants": { "patterns": [{ "name": "constant.language.boolean.qiy", "match": "\\b(?:true|false)\\b" }, { "name": "constant.language.provider.qiy", "match": "\\b(?:local|s3|oidc|oauth2|sso|rest|graphql|native|yoga|apollo|one|many|restrict|cascade|setNull|count|distribution|trend|auto|manual|created|updated|deleted)\\b" }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.integer.qiy", "match": "\\b\\d+\\b" }] },
    "operators": { "patterns": [{ "name": "punctuation.section.block.qiy", "match": "[{}]" }, { "name": "punctuation.separator.qiy", "match": "[();,.]" }] }
  }
}
